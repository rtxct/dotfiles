#compdef vm

_vm() {
  local -a commands path_parts segments
  local VM_DIR f cmdpath next_part match
  
  # Locate the 'vm' executable to dynamically find the library directory
  local vm_bin=${commands[vm]}
  if [[ -n "$vm_bin" ]]; then
    vm_bin=${vm_bin:A} # Resolve symlinks to absolute path
    VM_DIR="${vm_bin:h}/../lib/vm"
  fi
  
  # Fallback to absolute workspace path if not found in PATH or not yet installed
  if [[ ! -d "$VM_DIR" ]]; then
    VM_DIR="$(dirname ${(%):-%N})/../../local/lib/vm"
  fi

  if [[ ! -d "$VM_DIR" ]]; then
    VM_DIR="/usr/local/lib/vm"
  fi

  # If directory completely missing, fallback to normal file completion
  if [[ ! -d "$VM_DIR" ]]; then
    _files
    return
  fi

  # Extract typed subcommands (excluding the command 'vm' and the current word being typed)
  # CURRENT is the index of the word cursor is on (1-based, 1 is 'vm')
  path_parts=("${(@)words[2,CURRENT-1]}")
  
  commands=()
  for f in "$VM_DIR"/vm-*(N); do
    cmdpath="${f##*/}"
    cmdpath="${cmdpath#vm-}"
    
    # Split the command path by '-'
    segments=("${(@s/-/)cmdpath}")
    
    # Check if the segments match the path_parts typed so far
    match=1
    for (( i=1; i<=${#path_parts}; i++ )); do
      if [[ "${segments[i]}" != "${path_parts[i]}" ]]; then
        match=0
        break
      fi
    done
    
    if (( match )); then
      next_part="${segments[${#path_parts} + 1]}"
      [[ -n "$next_part" ]] && commands+=("$next_part")
    fi
  done
  
  # Unique the commands array
  commands=("${(@u)commands}")
  
  if [[ ${#commands[@]} -gt 0 ]]; then
    _describe 'vm command' commands
  else
    # If no subcommands match, we are likely expecting file arguments (like an XML or ISO path)
    _files
  fi
}

_vm "$@"
