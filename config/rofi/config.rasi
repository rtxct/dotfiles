configuration {
    font: "JetBrainsMono Nerd Font Medium 10";
    line-margin: 10;

    display-ssh:    "";
    display-run:    "";
    display-drun:   "";
    display-window: "";
    display-combi:  "";
    show-icons:     false;

    modi: "window,calc";
}

@theme "~/.config/rofi/monochrome.rasi"

listview {
	lines: 6;
	columns: 1;
}

window {
	width: 40%;
	height: 50%;
}
