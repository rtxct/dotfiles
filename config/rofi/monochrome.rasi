* {
    gray0: #0a0a0a;
    gray1: #1a1a1a;
    gray2: #2a2a2a;
    gray4: #7a7a7a;
    gray6: #e0e0e0;
    gray7: #f5f5f5;
    white: #FFFFFF;

    foreground:  @gray6;
    background-color:  transparent;
    transparent: rgba(0, 0, 0, 0);
}

window {
    location: center;
    anchor:   center;
    padding: 10px;
    border:  0px;
    background-color: @transparent;
    spacing: 0;
    children: [mainbox];
    orientation: horizontal;
}

mainbox {
    spacing: 0;
    children: [inputbar, message, listview];
}

message {
    color: @gray7;
    padding: 5;
    border-color: @white;
    border: 2px 2px 2px 2px;
    background-color: @gray2;
}

inputbar {
    color: @gray7;
    padding: 11px;
    background-color: @gray1;
    border: 1px 1px 1px 1px;
    border-color: @white;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em;
}

listview {
    padding: 8px;
    border-color: @white;
    border: 0px 1px 1px 1px;
    background-color: rgba(20, 20, 20, 0.9);
    dynamic: false;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    background-color: transparent;
    color: @foreground;
    text-color: @gray6;
}

element selected.normal {
    background-color: @gray4;
    text-color: @gray0;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}

button selected normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}

textbox {
    padding: 8px;
    border-color: @white;
    border: 1px;
    background-color: rgba(20, 20, 20, 0.9);
    dynamic: true;
    text-color: @gray7;
}

