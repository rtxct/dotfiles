if status is-interactive
    abbr --add rl reload
    abbr --add rel reload

    abbr --add cl clear
    abbr --add tl 'tail -500f'

    abbr --add v vim
    abbr --add nv nvim

    abbr --add k kubectl
    abbr --add dc 'docker compose'
    abbr --add dk docker

    abbr --add g git
    abbr --add gst 'git status'
    abbr --add ga 'git add'
    abbr --add gaa 'git add .'
    abbr --add gc 'git commit'
    abbr --add gp 'git push'
    abbr --add grst 'git restore'
    abbr --add grsta 'git restore .'
    abbr --add gs 'git stash'
    abbr --add gsp 'git stash push -m'

    abbr --add config 'cd ~/.config/'
    abbr --add dwn 'cd ~/Downloads/'
    abbr --add wall 'cd ~/.local/share/themes/wallpaper/'
    abbr --add usr 'cd /usr'
end
